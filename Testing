if getgenv().BriskLoaded then return end
getgenv().BriskLoaded = true

local function Part1()
    local repo = "https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/"
    local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
    local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
    local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

    local Window = Library:CreateWindow({
        Title = "Brisk Survival",
        Footer = "by @sigmatop1jj",
        Center = true, AutoShow = true, Resizable = true,
    })

    pcall(function() if Library.ToggleFrame then Library.ToggleFrame.Visible = false end end)
    pcall(function() if Library.KeybindFrame then Library.KeybindFrame.Visible = false end end)

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UIS = game:GetService("UserInputService")
    local Lighting = game:GetService("Lighting")
    local LP = Players.LocalPlayer
    local Cam = workspace.CurrentCamera

    local keyStates, mouseStates = {}, {}
    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseStates.MouseButton1 = true
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then mouseStates.MouseButton2 = true end
        if input.KeyCode ~= Enum.KeyCode.Unknown then keyStates[input.KeyCode.Name] = true end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseStates.MouseButton1 = false
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then mouseStates.MouseButton2 = false end
        if input.KeyCode ~= Enum.KeyCode.Unknown then keyStates[input.KeyCode.Name] = false end
    end)

    local function IsKeyActive(keyStr)
        if not keyStr or keyStr == "" then return false end
        keyStr = tostring(keyStr)
        if keyStr:find("MouseButton") then return mouseStates[keyStr] == true end
        return keyStates[keyStr] == true
    end

    local Vars = {
        -- Silent Aim
        SilentAim = true, SilentAimTarget = "Head", SilentAimFov = 300, SilentAimTeamCheck = true,
        SilentAimVisibleCheck = true,
        -- Aimbot
        AimbotEnabled = false, AimbotKeybind = "MouseButton2", AimbotAlways = false,
        AimbotTarget = "Head", AimbotFov = 150, AimbotSmoothness = 5, AimbotPrediction = 0.165,
        AimbotVisibleCheck = true, AimbotMaxDist = 1000,
        FovCircleEnabled = true, FovCircleFilled = false, FovCircleThickness = 2,
        FovCircleRainbow = false, FovCircleColor = Color3.fromRGB(255, 255, 255),
        -- ESP
        ESPBox = false, ESPName = false, ESPHealth = false, ESPMaxDist = 1000,
        -- Chams & Tracers
        ChamsEnabled = false, ChamsColor = Color3.fromRGB(255, 0, 0),
        TracerEnabled = false, TracerColor = Color3.fromRGB(180, 100, 255),
        -- Sounds
        HitSoundEnabled = false, HitSoundChoice = "Skeet",
        -- World
        Fullbright = false, Crosshair = false,
        -- Cosmetics
        SkinChanger = false, SkinColor = Color3.fromRGB(0, 255, 255),
    }

    local function T(box, key, text, default)
        box:AddToggle(key, { Text = text, Default = default or Vars[key], Callback = function(v) Vars[key] = v end })
    end
    local function S(box, key, text, default, min, max, rounding)
        box:AddSlider(key, { Text = text, Default = default or Vars[key], Min = min, Max = max, Rounding = rounding or 0, Callback = function(v) Vars[key] = v end })
    end
    local function C(box, key, text, default)
        box:AddLabel(text):AddColorPicker(key, { Default = default or Vars[key], Callback = function(v) Vars[key] = v end })
    end

    local HSList = {
        ["None"] = "", ["Skeet"] = "rbxassetid://83717596220569",
        ["Minecraft"] = "rbxassetid://8766809464", ["Bell"] = "rbxassetid://123827281575056",
        ["Fart"] = "rbxassetid://4809574295"
    }
    local HSNames = {"None", "Skeet", "Minecraft", "Bell", "Fart"}

    local Combat = Window:AddTab("Combat")
    local Visuals = Window:AddTab("Visuals")
    local Cosmetics = Window:AddTab("Cosmetics")
    local Settings = Window:AddTab("Settings")

    -- COMBAT
    local SG = Combat:AddLeftGroupbox("Silent Aim")
    T(SG, "SilentAim", "Enable Silent Aim", true)
    SG:AddDropdown("SilentAimTarget", { Text = "Target Part", Values = {"Head", "Torso", "HumanoidRootPart"}, Default = "Head", Callback = function(v) Vars.SilentAimTarget = v end })
    S(SG, "SilentAimFov", "FOV", 300, 10, 1000, 0)
    T(SG, "SilentAimVisibleCheck", "Visible Check", true)
    T(SG, "SilentAimTeamCheck", "Team Check", true)

    local AG = Combat:AddRightGroupbox("Aimbot")
    T(AG, "AimbotEnabled", "Enable Aimbot", false)
    T(AG, "AimbotAlways", "Auto Aim (no key)", false)
    AG:AddLabel("Aim Keybind"):AddKeyPicker("AimKeybind", { Default = "MouseButton2", Text = "Aim Key", Callback = function(v)
        if type(v) == "table" then Vars.AimbotKeybind = v.Key or "MouseButton2" else Vars.AimbotKeybind = tostring(v) end
    end })
    AG:AddDropdown("AimbotTarget", { Text = "Target Part", Values = {"Head", "Torso", "HumanoidRootPart"}, Default = "Head", Callback = function(v) Vars.AimbotTarget = v end })
    T(AG, "AimbotVisibleCheck", "Visible Check", true)
    S(AG, "AimbotFov", "FOV", 150, 10, 800, 0)
    S(AG, "AimbotMaxDist", "Max Distance", 1000, 100, 5000, 0)
    S(AG, "AimbotSmoothness", "Smoothness", 5, 1, 20, 0)
    S(AG, "AimbotPrediction", "Prediction", 0.165, 0, 0.5, 3)

    local FOVC = Combat:AddRightGroupbox("Aim FOV Circle")
    T(FOVC, "FovCircleEnabled", "Show Circle", true)
    T(FOVC, "FovCircleFilled", "Filled", false)
    S(FOVC, "FovCircleThickness", "Thickness", 2, 1, 10, 0)
    T(FOVC, "FovCircleRainbow", "Rainbow", false)
    C(FOVC, "FovCircleColor", "Color", Color3.fromRGB(255, 255, 255))

    -- VISUALS
    local VG = Visuals:AddLeftGroupbox("Player ESP")
    T(VG, "ESPBox", "Box", false)
    T(VG, "ESPName", "Name", false)
    T(VG, "ESPHealth", "Health Bar", false)
    S(VG, "ESPMaxDist", "Max Distance", 1000, 100, 5000, 0)

    local VG2 = Visuals:AddLeftGroupbox("Chams")
    T(VG2, "ChamsEnabled", "Enable Chams", false)
    C(VG2, "ChamsColor", "Chams Color", Color3.fromRGB(255, 0, 0))

    local VG3 = Visuals:AddRightGroupbox("Tracers & Sounds")
    T(VG3, "TracerEnabled", "Enable Tracers", false)
    C(VG3, "TracerColor", "Tracer Color", Color3.fromRGB(180, 100, 255))
    VG3:AddDivider()
    T(VG3, "HitSoundEnabled", "Hit Sound", false)
    VG3:AddDropdown("HitSoundChoice", { Text = "Select Sound", Values = HSNames, Default = "Skeet", Callback = function(v) Vars.HitSoundChoice = v end })

    local VG4 = Visuals:AddRightGroupbox("World")
    T(VG4, "Fullbright", "Fullbright", false)
    T(VG4, "Crosshair", "Crosshair", false)

    -- COSMETICS
    local CosmG = Cosmetics:AddLeftGroupbox("Skin Changer")
    T(CosmG, "SkinChanger", "Enable Skin (ForceField)", false)
    C(CosmG, "SkinColor", "Skin Color", Color3.fromRGB(0, 255, 255))

    -- SETTINGS
    local MenuG = Settings:AddLeftGroupbox("Menu")
    MenuG:AddButton("Unload", function()
        pcall(function() Library:Unload() end)
        getgenv().BriskLoaded = nil
    end)

    ThemeManager:SetLibrary(Library)
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({ "AimKeybind" })
    ThemeManager:SetFolder("BriskSurvival")
    SaveManager:SetFolder("BriskSurvival")
    SaveManager:BuildConfigSection(Settings)
    ThemeManager:ApplyToTab(Settings)
    SaveManager:LoadAutoloadConfig()

    getgenv().Brisk = {
        Vars = Vars, Library = Library, Players = Players, RunService = RunService, UIS = UIS, Lighting = Lighting,
        LP = LP, Cam = Cam, IsKeyActive = IsKeyActive, HSList = HSList
    }
end

local function Part2()
    if not getgenv().Brisk then return end
    local S = getgenv().Brisk
    local Vars, Players, RunService, UIS, Lighting, LP, Cam = S.Vars, S.Players, S.RunService, S.UIS, S.Lighting, S.LP, S.Cam
    local IsKeyActive, HSList = S.IsKeyActive, S.HSList

    local lastShotTick = 0
    local activeTracers = {}

    -- TRACERS LOGIC
    local function CreateTracer(startPos, endPos)
        local part = Instance.new("Part")
        part.Anchored = true; part.CanCollide = false; part.Transparency = 1
        part.Parent = workspace
        
        local a0 = Instance.new("Attachment", part); local a1 = Instance.new("Attachment", part)
        local beam = Instance.new("Beam", part)
        beam.Attachment0 = a0; beam.Attachment1 = a1
        beam.FaceCamera = true; beam.LightEmission = 1; beam.LightInfluence = 0
        beam.Color = ColorSequence.new(Vars.TracerColor)
        beam.Width0 = 1.5; beam.Width1 = 1.5; beam.Transparency = NumberSequence.new(0.2)
        
        a0.WorldPosition = startPos; a1.WorldPosition = endPos
        table.insert(activeTracers, {part = part, born = tick()})
    end

    RunService.Heartbeat:Connect(function()
        pcall(function()
            for i = #activeTracers, 1, -1 do
                local t = activeTracers[i]
                if tick() - t.born > 0.4 then
                    t.part:Destroy()
                    table.remove(activeTracers, i)
                end
            end
        end)
    end)

    -- VISIBLE CHECK FUNCTION
    local excludeEnum = Enum.RaycastFilterType.Exclude or Enum.RaycastFilterType.Blacklist
    local function IsVisible(targetChar, targetPart)
        if not Vars.SilentAimVisibleCheck then return true end
        local ok, result = pcall(function()
            local myChar = LP.Character; if not myChar then return false end
            local params = RaycastParams.new()
            params.FilterType = excludeEnum
            params.FilterDescendantsInstances = {myChar, targetChar}
            local res = workspace:Raycast(Cam.CFrame.Position, targetPart.Position - Cam.CFrame.Position, params)
            return res == nil
        end)
        return ok and result or false
    end

    -- SILENT AIM HOOK (Fixed: No Origin Spoof, Visible Check Added)
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        
        if not checkcaller() and method == "FireServer" and self.Name == "GunFire" then
            local args = {...}
            
            if Vars.SilentAim and args[1] and typeof(args[1]) == "Vector3" then
                local origin = args[1] -- Use original origin (player's real position)
                local bestTarget, bestPlayer, bestDist = nil, nil, Vars.SilentAimFov
                local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)

                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character then
                        if Vars.SilentAimTeamCheck and p.Team == LP.Team then continue end
                        local part = p.Character:FindFirstChild(Vars.SilentAimTarget) or p.Character:FindFirstChild("HumanoidRootPart")
                        if part then
                            local hum = p.Character:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                -- Check if visible
                                if IsVisible(p.Character, part) then
                                    local screenPos, onScreen = Cam:WorldToViewportPoint(part.Position)
                                    if onScreen then
                                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                        if dist < bestDist then
                                            bestDist = dist; bestTarget = part; bestPlayer = p
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                if bestTarget and bestPlayer then
                    -- Only modify target position, direction, and user ID
                    -- Leave origin (args[1]) alone!
                    args[2] = bestTarget.Position
                    args[3] = (bestTarget.Position - origin).Unit
                    args[6] = true
                    args[7] = bestPlayer.UserId
                    
                    lastShotTick = tick()
                    if Vars.TracerEnabled then
                        task.spawn(CreateTracer, origin, bestTarget.Position)
                    end
                    
                    return oldNamecall(self, unpack(args))
                end
            end
            lastShotTick = tick()
        end
        return oldNamecall(self, ...)
    end)

    -- REGULAR AIMBOT
    local function GetTargetPart(char, mode)
        if not char then return nil end
        mode = mode or "Head"
        if mode == "Head" then return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        elseif mode == "Torso" then return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
        else return char:FindFirstChild("HumanoidRootPart") end
    end

    local function IsVisibleAimbot(targetChar, mode)
        local ok, result = pcall(function()
            local myChar = LP.Character; if not myChar then return false end
            local targetPart = GetTargetPart(targetChar, mode)
            if not targetPart then return false end
            local params = RaycastParams.new()
            params.FilterType = excludeEnum
            params.FilterDescendantsInstances = {myChar, targetChar}
            local res = workspace:Raycast(Cam.CFrame.Position, targetPart.Position - Cam.CFrame.Position, params)
            return res == nil
        end)
        return ok and result or false
    end

    RunService.RenderStepped:Connect(function()
        pcall(function()
            if not Vars.AimbotEnabled then return end
            if not Vars.AimbotAlways and not IsKeyActive(Vars.AimbotKeybind) then return end
            
            local myChar = LP.Character
            if not myChar then return end
            local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
            local bestChar, bestDist = nil, Vars.AimbotFov

            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP and p.Character then
                    if Vars.SilentAimTeamCheck and p.Team == LP.Team then continue end
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        if Vars.AimbotVisibleCheck and not IsVisibleAimbot(p.Character, Vars.AimbotTarget) then continue end
                        local part = GetTargetPart(p.Character, Vars.AimbotTarget)
                        if part then
                            local pos, onScreen = Cam:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                                if d < bestDist then bestDist = d; bestChar = p.Character end
                            end
                        end
                    end
                end
            end
            
            if bestChar then
                local part = GetTargetPart(bestChar, Vars.AimbotTarget)
                local root = bestChar:FindFirstChild("HumanoidRootPart")
                if part and root then
                    local targetPos = part.Position + root.Velocity * Vars.AimbotPrediction
                    Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, targetPos), 1 / Vars.AimbotSmoothness)
                end
            end
        end)
    end)

    -- FOV CIRCLE
    local FovCircle = Drawing.new("Circle")
    FovCircle.Visible = false; FovCircle.Transparency = 1; FovCircle.NumSides = 60
    RunService.RenderStepped:Connect(function()
        pcall(function()
            if not Vars.FovCircleEnabled then FovCircle.Visible = false; return end
            local color = Vars.FovCircleColor
            if Vars.FovCircleRainbow then color = Color3.fromHSV((tick()*0.5)%1, 1, 1) end
            FovCircle.Visible = true
            FovCircle.Position = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
            FovCircle.Radius = Vars.AimbotFov
            FovCircle.Thickness = Vars.FovCircleThickness
            FovCircle.Filled = Vars.FovCircleFilled
            FovCircle.Color = color
        end)
    end)

    -- ESP & CHAMS
    local ESPData = {}
    local ChamsData = {}
    
    local function CreateESP(p)
        if ESPData[p] then return end
        ESPData[p] = {
            Box = Drawing.new("Square"), Name = Drawing.new("Text"), Health = Drawing.new("Square")
        }
        ESPData[p].Box.Thickness = 1; ESPData[p].Box.Filled = false
        ESPData[p].Name.Size = 14; ESPData[p].Name.Center = true; ESPData[p].Name.Outline = true
        ESPData[p].Health.Thickness = 1; ESPData[p].Health.Filled = true
    end

    for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
    Players.PlayerAdded:Connect(CreateESP)

    RunService.RenderStepped:Connect(function()
        pcall(function()
            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            for p, data in pairs(ESPData) do
                local hide = not Vars.ESPBox and not Vars.ESPName and not Vars.ESPHealth
                if not myRoot or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then hide = true end
                
                if hide then
                    data.Box.Visible = false; data.Name.Visible = false; data.Health.Visible = false
                else
                    local root = p.Character.HumanoidRootPart
                    local head = p.Character:FindFirstChild("Head") or root
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    local dist = (myRoot.Position - root.Position).Magnitude
                    
                    if dist > Vars.ESPMaxDist then
                        data.Box.Visible = false; data.Name.Visible = false; data.Health.Visible = false
                    else
                        local pos, onScreen = Cam:WorldToViewportPoint(root.Position)
                        local headPos = Cam:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                        if not onScreen then
                            data.Box.Visible = false; data.Name.Visible = false; data.Health.Visible = false
                        else
                            local height = math.abs(pos.Y - headPos.Y) * 2.2
                            local width = height * 0.6
                            
                            data.Box.Visible = Vars.ESPBox
                            data.Box.Color = Color3.fromRGB(255, 255, 255)
                            data.Box.Size = Vector2.new(width, height)
                            data.Box.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)
                            
                            data.Name.Visible = Vars.ESPName
                            data.Name.Text = p.Name
                            data.Name.Color = Color3.fromRGB(255, 255, 255)
                            data.Name.Position = Vector2.new(pos.X, pos.Y - height/2 - 15)
                            
                            if Vars.ESPHealth and hum then
                                data.Health.Visible = true
                                local hp = hum.Health / hum.MaxHealth
                                data.Health.Color = Color3.fromRGB(255*(1-hp), 255*hp, 0)
                                data.Health.Size = Vector2.new(2, height * hp)
                                data.Health.Position = Vector2.new(pos.X - width/2 - 4, (pos.Y - height/2) + (height * (1-hp)))
                            else
                                data.Health.Visible = false
                            end
                        end
                    end
                end
            end
        end)
    end)

    RunService.Heartbeat:Connect(function()
        pcall(function()
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LP then continue end
                local show = Vars.ChamsEnabled and p.Character
                if show then
                    if not ChamsData[p] or not ChamsData[p].Parent then
                        local h = Instance.new("Highlight")
                        h.Name = "BriskChams"; h.Parent = p.Character
                        h.FillColor = Vars.ChamsColor
                        h.OutlineColor = Color3.new(1,1,1)
                        h.FillTransparency = 0.5; h.OutlineTransparency = 0
                        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        ChamsData[p] = h
                    else
                        ChamsData[p].FillColor = Vars.ChamsColor
                    end
                else
                    if ChamsData[p] and ChamsData[p].Parent then
                        ChamsData[p]:Destroy()
                        ChamsData[p] = nil
                    end
                end
            end
        end)
    end)

    -- HIT SOUNDS
    local function PlayHitSound()
        if not Vars.HitSoundEnabled or Vars.HitSoundChoice == "None" then return end
        local id = HSList[Vars.HitSoundChoice]
        if id and id ~= "" then
            local snd = Instance.new("Sound")
            snd.SoundId = id; snd.Volume = 1
            snd.Parent = LP.Character or workspace
            snd:Play()
            task.delay(2, function() snd:Destroy() end)
        end
    end

    local function TrackDamage(p)
        if p == LP then return end
        local function bind(char)
            local hum = char:WaitForChild("Humanoid", 5)
            if not hum then return end
            local prevHP = hum.Health
            hum.HealthChanged:Connect(function(newHP)
                if newHP < prevHP and tick() - lastShotTick < 0.5 then
                    PlayHitSound()
                end
                prevHP = newHP
            end)
        end
        if p.Character then bind(p.Character) end
        p.CharacterAdded:Connect(bind)
    end
    for _, p in ipairs(Players:GetPlayers()) do TrackDamage(p) end
    Players.PlayerAdded:Connect(TrackDamage)

    -- COSMETICS (SKIN)
    RunService.Heartbeat:Connect(function()
        pcall(function()
            if Vars.SkinChanger and LP.Character then
                for _, part in ipairs(LP.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Material = Enum.Material.ForceField
                        part.Color = Vars.SkinColor
                    end
                end
            end
        end)
    end)

    -- WORLD & CROSSHAIR
    local DefBright = Lighting.Brightness
    local DefAmbient = Lighting.OutdoorAmbient
    RunService.Heartbeat:Connect(function()
        pcall(function()
            if Vars.Fullbright then
                Lighting.Brightness = 2; Lighting.OutdoorAmbient = Color3.new(1,1,1)
            else
                Lighting.Brightness = DefBright; Lighting.OutdoorAmbient = DefAmbient
            end
        end)
    end)

    local chH = Drawing.new("Line"); chH.Thickness = 1.5; chH.Color = Color3.new(1,1,1)
    local chV = Drawing.new("Line"); chV.Thickness = 1.5; chV.Color = Color3.new(1,1,1)
    RunService.RenderStepped:Connect(function()
        pcall(function()
            if Vars.Crosshair then
                local c = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
                chH.From = c + Vector2.new(-6, 0); chH.To = c + Vector2.new(6, 0); chH.Visible = true
                chV.From = c + Vector2.new(0, -6); chV.To = c + Vector2.new(0, 6); chV.Visible = true
            else
                chH.Visible = false; chV.Visible = false
            end
        end)
    end)
end

Part1()
