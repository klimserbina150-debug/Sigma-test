-- ===================== AIMBOT LOGIC =====================
local function GetClosestTarget()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestDist = nil, Vars.AimbotFov
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local part = p.Character:FindFirstChild(Vars.AimbotTarget)
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if part and hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = part
                    end
                end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if not Vars.AimbotEnabled then return end
        if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
        
        local target = GetClosestTarget()
        if target then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, target.Position), 1 / Vars.AimbotSmoothness)
        end
    end)
end)

-- ===================== ESP LOGIC =====================
local ESPData = {}

local function CreateESP(p)
    if ESPData[p] then return end
    ESPData[p] = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text")
    }
    ESPData[p].Box.Thickness = 1; ESPData[p].Box.Filled = false
    ESPData[p].Name.Size = 14; ESPData[p].Name.Center = true; ESPData[p].Name.Outline = true
end

for _, p in ipairs(Players:GetPlayers()) do CreateESP(p) end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(function(p)
    if ESPData[p] then
        if ESPData[p].Box then ESPData[p].Box:Remove() end
        if ESPData[p].Name then ESPData[p].Name:Remove() end
        ESPData[p] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    pcall(function()
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        for p, data in pairs(ESPData) do
            local hide = not Vars.ESPBox and not Vars.ESPName
            if not myRoot or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then hide = true end
            
            if hide then
                data.Box.Visible = false
                data.Name.Visible = false
            else
                local root = p.Character.HumanoidRootPart
                local head = p.Character:FindFirstChild("Head") or root
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                
                if not onScreen or (hum and hum.Health <= 0) then
                    data.Box.Visible = false
                    data.Name.Visible = false
                else
                    local height = math.abs(pos.Y - headPos.Y) * 2.2
                    local width = height * 0.6
                    
                    data.Box.Visible = Vars.ESPBox
                    data.Box.Color = Color3.new(1,1,1)
                    data.Box.Size = Vector2.new(width, height)
                    data.Box.Position = Vector2.new(pos.X - width/2, pos.Y - height/2)
                    
                    data.Name.Visible = Vars.ESPName
                    data.Name.Text = p.Name
                    data.Name.Color = Color3.new(1,1,1)
                    data.Name.Position = Vector2.new(pos.X, pos.Y - height/2 - 15)
                end
            end
        end
    end)
end)
