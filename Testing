local function createFeature(parent, name, default, callback, hasSettings)
    hasSettings = hasSettings ~= false

    local block = Instance.new("Frame", parent)
    block.Size = UDim2.new(1, 0, 0, 32)
    block.BackgroundColor3 = Color3.fromRGB(8,8,8)
    block.BackgroundTransparency = 0.3
    block.ClipsDescendants = true
    block.BorderSizePixel = 0
    Instance.new("UICorner", block).CornerRadius = UDim.new(0, 5)

    local topBtn = Instance.new("TextButton", block)
    topBtn.Size = UDim2.new(1, 0, 0, 32)
    topBtn.BackgroundTransparency = 1
    topBtn.Text = ""
    topBtn.AutoButtonColor = false

    local lbl = Instance.new("TextLabel", topBtn)
    lbl.Text = name
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 11
    lbl.TextColor3 = Color3.new(1,1,1)
    lbl.Size = UDim2.new(1, -45, 1, 0)
    lbl.Position = UDim2.fromOffset(12, 0)
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local tbg = Instance.new("Frame", topBtn)
    tbg.Size = UDim2.fromOffset(24, 12)
    tbg.Position = UDim2.new(1, -12, 0.5, 0)
    tbg.AnchorPoint = Vector2.new(1, 0.5)
    tbg.BackgroundColor3 = default and Color3.new(1,1,1) or Color3.fromRGB(45,45,45)
    tbg.BorderSizePixel = 0
    Instance.new("UICorner", tbg).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame", tbg)
    dot.Size = UDim2.fromOffset(8, 8)
    dot.Position = default and UDim2.new(1, -10, 0.5, -4) or UDim2.fromOffset(2, 2)
    dot.BackgroundColor3 = Color3.new(0,0,0)
    dot.BorderSizePixel = 0
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1,0)

    local click = Instance.new("TextButton", tbg)
    click.Size = UDim2.fromScale(1,1)
    click.BackgroundTransparency = 1
    click.Text = ""

    local state = default
    featureStates[name] = state

    local function setState(value, fire)
        state = value
        featureStates[name] = value
        TS:Create(tbg, TweenInfo.new(0.2), {
            BackgroundColor3 = value and Color3.new(1,1,1) or Color3.fromRGB(45,45,45)
        }):Play()
        TS:Create(dot, TweenInfo.new(0.2), {
            Position = value and UDim2.new(1,-10,0.5,-4) or UDim2.fromOffset(2,2)
        }):Play()
        if fire and callback then callback(value) end
    end

    click.MouseButton1Click:Connect(function()
        setState(not state, true)
    end)

    featureForce[name] = function(value)
        setState(value, true)
    end

    if callback then callback(state) end

    local setCont = Instance.new("Frame", block)
    setCont.Size = UDim2.new(1, 0, 0, 0)
    setCont.Position = UDim2.fromOffset(0, 32)
    setCont.BackgroundTransparency = 1
    setCont.ClipsDescendants = true

    local sLayout = Instance.new("UIListLayout", setCont)
    sLayout.Padding = UDim.new(0, 4)

    local sPad = Instance.new("UIPadding", setCont)
    sPad.PaddingTop = UDim.new(0, 6)
    sPad.PaddingBottom = UDim.new(0, 6)
    sPad.PaddingLeft = UDim.new(0, 12)
    sPad.PaddingRight = UDim.new(0, 12)

    local expanded = false

    if hasSettings then
        topBtn.MouseButton1Click:Connect(function()
            expanded = not expanded
            local target = 32
            if expanded then
                target = 32 + 12 + sLayout.AbsoluteContentSize.Y
            end
            TS:Create(block, TweenInfo.new(0.2), {
                Size = UDim2.new(1,0,0,target)
            }):Play()
        end)
    end

    return setCont
end

local function addSlider(parent, name, min, max, default, callback)
    local f = Instance.new("Frame", parent)
    f.Size = UDim2.new(1,0,0,24)
    f.BackgroundTransparency = 1

    local label = Instance.new("TextLabel", f)
    label.Text = name
    label.TextColor3 = Color3.fromRGB(150,150,150)
    label.Font = Enum.Font.Gotham
    label.TextSize = 10
    label.Size = UDim2.new(0.5,0,0,12)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left

    local valueLabel = Instance.new("TextLabel", f)
    valueLabel.Text = tostring(default)
    valueLabel.TextColor3 = Color3.fromRGB(150,150,150)
    valueLabel.Font = Enum.Font.Gotham
    valueLabel.TextSize = 10
    valueLabel.Size = UDim2.new(0.5,0,0,12)
    valueLabel.Position = UDim2.fromScale(0.5,0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local bg = Instance.new("Frame", f)
    bg.Size = UDim2.new(1,0,0,2)
    bg.Position = UDim2.fromOffset(0,20)
    bg.BackgroundColor3 = Color3.fromRGB(20,20,20)
    bg.BorderSizePixel = 0

    local fill = Instance.new("Frame", bg)
    fill.Size = UDim2.new((default-min)/(max-min),0,1,0)
    fill.BackgroundColor3 = Color3.new(1,1,1)
    fill.BorderSizePixel = 0

    local dragging = false

    local function update(x)
        local pos = math.clamp((x-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1)
        fill.Size = UDim2.new(pos,0,1,0)
        local value = math.floor(min+(max-min)*pos)
        valueLabel.Text = tostring(value)
        if callback then callback(value) end
    end

    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function addDropdown(parent, name, options, defaultIndex, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1,0,0,18)
    row.BackgroundTransparency = 1

    local label = Instance.new("TextLabel", row)
    label.Text = name
    label.TextColor3 = Color3.fromRGB(150,150,150)
    label.Font = Enum.Font.Gotham
    label.TextSize = 10
    label.Size = UDim2.new(0.5,0,1,0)
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left

    local button = Instance.new("TextButton", row)
    button.Size = UDim2.fromOffset(70,18)
    button.Position = UDim2.new(1,0,0.5,0)
    button.AnchorPoint = Vector2.new(1,0.5)
    button.BackgroundColor3 = Color3.fromRGB(30,30,30)
    button.Text = options[defaultIndex]
    button.TextColor3 = Color3.new(1,1,1)
    button.Font = Enum.Font.Gotham
    button.TextSize = 9
    button.BorderSizePixel = 0
    Instance.new("UICorner",button).CornerRadius = UDim.new(0,3)

    local list = Instance.new("Frame", parent)
    list.Size = UDim2.new(1,0,0,0)
    list.BackgroundTransparency = 1
    list.ClipsDescendants = true

    local layout = Instance.new("UIListLayout", list)
    layout.Padding = UDim.new(0,2)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Right

    local current = options[defaultIndex]
    local open = false

    for _, option in ipairs(options) do
        local opt = Instance.new("TextButton", list)
        opt.Size = UDim2.fromOffset(70,16)
        opt.BackgroundColor3 = Color3.fromRGB(25,25,25)
        opt.Text = option
        opt.TextColor3 = Color3.fromRGB(150,150,150)
        opt.Font = Enum.Font.Gotham
        opt.TextSize = 9
        opt.Visible = option ~= current
        opt.BorderSizePixel = 0
        Instance.new("UICorner",opt).CornerRadius = UDim.new(0,3)

        opt.MouseButton1Click:Connect(function()
            current = option
            button.Text = option
            open = false
            TS:Create(list,TweenInfo.new(0.15),{
                Size = UDim2.new(1,0,0,0)
            }):Play()
            for _, child in ipairs(list:GetChildren()) do
                if child:IsA("TextButton") then
                    child.Visible = child.Text ~= current
                end
            end
            if callback then callback(option) end
        end)
    end

    button.MouseButton1Click:Connect(function()
        open = not open
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then
                child.Visible = child.Text ~= current
            end
        end
        local height = open and layout.AbsoluteContentSize.Y or 0
        TS:Create(list,TweenInfo.new(0.15),{
            Size = UDim2.new(1,0,0,height)
        }):Play()
    end)

    if callback then callback(current) end
end

