    function G:AddSlider(key, opts)
        opts = opts or {}
        local minV = opts.Min or 0
        local maxV = opts.Max or 100
        local rounding = opts.Rounding or 0
        local state = opts.Default or minV

        local row = Instance.new("Frame", g)
        row.Size = UDim2.new(1,0,0,24)
        row.BackgroundTransparency = 1
        row.LayoutOrder = nextOrder()

        local lbl = Instance.new("TextLabel", row)
        lbl.Text = opts.Text or key
        lbl.TextColor3 = MUTED
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 10
        lbl.Size = UDim2.new(0.6,0,0,12)
        lbl.BackgroundTransparency = 1
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local valLbl = Instance.new("TextLabel", row)
        valLbl.Text = tostring(state)
        valLbl.TextColor3 = WHITE
        valLbl.Font = Enum.Font.Gotham
        valLbl.TextSize = 10
        valLbl.Size = UDim2.new(0.4,0,0,12)
        valLbl.Position = UDim2.fromScale(0.6,0)
        valLbl.BackgroundTransparency = 1
        valLbl.TextXAlignment = Enum.TextXAlignment.Right

        local track = Instance.new("Frame", row)
        track.Size = UDim2.new(1,0,0,2)
        track.Position = UDim2.fromOffset(0,18)
        track.BackgroundColor3 = TRACK_BG
        track.BorderSizePixel = 0

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new((state-minV)/math.max(maxV-minV,0.0001),0,1,0)
        fill.BackgroundColor3 = WHITE
        fill.BorderSizePixel = 0

        local function fmt(v)
            if rounding > 0 then return string.format("%."..rounding.."f", v) end
            return tostring(math.floor(v + 0.5))
        end

        local function setFromX(x)
            local pos = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            local v = minV + (maxV - minV) * pos
            if rounding > 0 then
                local m = 10 ^ rounding
                v = math.floor(v * m + 0.5) / m
            else
                v = math.floor(v + 0.5)
            end
            if v ~= state then
                state = v
                fill.Size = UDim2.new((state-minV)/math.max(maxV-minV,0.0001),0,1,0)
                valLbl.Text = fmt(state)
                if opts.Callback then pcall(opts.Callback, state) end
            end
        end

        local hit = Instance.new("TextButton", row)
        hit.Size = UDim2.new(1,0,1,0)
        hit.BackgroundTransparency = 1
        hit.Text = ""

        local dragging = false
        hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromX(input.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        valLbl.Text = fmt(state)

        return {
            SetValue = function(v)
                state = math.clamp(v, minV, maxV)
                fill.Size = UDim2.new((state-minV)/math.max(maxV-minV,0.0001),0,1,0)
                valLbl.Text = fmt(state)
                if opts.Callback then pcall(opts.Callback, state) end
            end,
            GetValue = function() return state end,
        }
    end

    function G:AddDropdown(key, opts)
        opts = opts or {}
        local isMulti = opts.Multi == true
        local values = opts.Values or {}
        local state
        if isMulti then
            state = {}
            if type(opts.Default) == "table" then
                for k, v in pairs(opts.Default) do if v then state[k] = true end end
            end
        else
            state = opts.Default or (values[1] or "")
        end

        local row = Instance.new("Frame", g)
        row.Size = UDim2.new(1,0,0,18)
        row.BackgroundTransparency = 1
        row.LayoutOrder = nextOrder()

        local lbl = Instance.new("TextLabel", row)
        lbl.Text = opts.Text or key
        lbl.TextColor3 = MUTED
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 10
        lbl.Size = UDim2.new(0.5,0,1,0)
        lbl.BackgroundTransparency = 1
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local selBtn = Instance.new("TextButton", row)
        selBtn.Size = UDim2.fromOffset(80,18)
        selBtn.Position = UDim2.new(1,0,0.5,0)
        selBtn.AnchorPoint = Vector2.new(1,0.5)
        selBtn.BackgroundColor3 = Color3.fromRGB(30,30,30)
        selBtn.TextColor3 = WHITE
        selBtn.Font = Enum.Font.Gotham
        selBtn.TextSize = 9
        selBtn.TextTruncate = Enum.TextTruncate.AtEnd
        selBtn.BorderSizePixel = 0
        Instance.new("UICorner", selBtn).CornerRadius = UDim.new(0,3)

        local function display()
            if isMulti then
                local c = 0
                for _, v in pairs(state) do if v then c = c + 1 end end
                if c == 0 then return "none" end
                if c == 1 then for k in pairs(state) do return k end end
                return c .. " selected"
            end
            return (state ~= "" and state) or "none"
        end
        local function refresh() selBtn.Text = display() end
        refresh()

        selBtn.MouseButton1Click:Connect(function()
            ClosePopup()
            local popup = Instance.new("Frame", sg)
            local h = math.min(#values * 20 + 8, 260)
            popup.Size = UDim2.fromOffset(140, h)
            local pPos = selBtn.AbsolutePosition
            local pY = pPos.Y + selBtn.AbsoluteSize.Y + 4
            if pY + h > workspace.CurrentCamera.ViewportSize.Y then pY = pPos.Y - h - 4 end
            popup.Position = UDim2.fromOffset(pPos.X + selBtn.AbsoluteSize.X - 140, pY)
            popup.BackgroundColor3 = POPUP_BG
            popup.BorderSizePixel = 0
            Instance.new("UICorner", popup).CornerRadius = UDim.new(0,5)
            currentPopup = popup

            local scroll = Instance.new("ScrollingFrame", popup)
            scroll.Size = UDim2.new(1,-8,1,-8)
            scroll.Position = UDim2.fromOffset(4,4)
            scroll.BackgroundTransparency = 1
            scroll.ScrollBarThickness = 2
            scroll.CanvasSize = UDim2.new()
            scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            local l = Instance.new("UIListLayout", scroll)
            l.Padding = UDim.new(0,2)

            local function rebuild()
                for _, c in ipairs(scroll:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for _, v in ipairs(values) do
                    local isSel = (isMulti and state[v]) or (not isMulti and state == v)
                    local opt = Instance.new("TextButton", scroll)
                    opt.Size = UDim2.new(1,0,0,18)
                    opt.BackgroundColor3 = isSel and WHITE or Color3.fromRGB(25,25,25)
                    opt.Text = tostring(v)
                    opt.TextColor3 = isSel and Color3.new(0,0,0) or MUTED
                    opt.Font = Enum.Font.Gotham
                    opt.TextSize = 9
                    opt.BorderSizePixel = 0
                    Instance.new("UICorner", opt).CornerRadius = UDim.new(0,3)
                    opt.MouseButton1Click:Connect(function()
                        if isMulti then
                            if state[v] then state[v] = nil else state[v] = true end
                            refresh()
                            if opts.Callback then pcall(opts.Callback, state) end
                            rebuild()
                        else
                            state = v
                            refresh()
                            if opts.Callback then pcall(opts.Callback, state) end
                            ClosePopup()
                        end
                    end)
                end
            end
            rebuild()

            local inside = false
            popup.MouseEnter:Connect(function() inside = true end)
            popup.MouseLeave:Connect(function() inside = false end)
            local conn
            conn = UIS.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 and not inside and currentPopup == popup then
                    conn:Disconnect()
                    ClosePopup()
                end
            end)
        end)

        return {
            SetValues = function(newValues)
                values = newValues or {}
                if isMulti then
                    local ns = {}
                    for k, v in pairs(state) do
                        if v then
                            for _, nv in ipairs(values) do if nv == k then ns[k] = true; break end end
                        end
                    end
                    state = ns
                else
                    local found = false
                    for _, v in ipairs(values) do if v == state then found = true; break end end
                    if not found then state = values[1] or "" end
                end
                refresh()
                if opts.Callback then pcall(opts.Callback, state) end
            end,
            GetValue = function() return state end,
        }
    end

